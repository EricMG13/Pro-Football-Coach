+    /// Writes the played coach's line for the season that just ended.
+    ///
+    /// `02` section 9: one line per season, for the played coach only, taken from the standings of
+    /// the tier they were employed in. Recorded rather than computed, because standings hold only
+    /// the current season and a `SeasonArchive` keeps no per-organisation win-loss, so once the
+    /// season is archived there is nothing left to compute it from.
+    static func recordCoachSeason(
+        after calendar: CalendarState,
+        in state: inout GameState
+    ) {
+        guard let coachID = state.career.coachID,
+              let job = state.careerArc.currentJob else { return }
+        let tier: Tier = job.tier == .college ? .college : .pro
+        guard let row = state.competition.standings[tier]?.first(where: {
+            $0.id == job.organisationID
+        }) else { return }
+        state.people.recordCoachSeason(
+            CoachSeasonRecord(
+                season: calendar.season,
+                organisationID: job.organisationID,
+                wins: row.wins,
+                losses: row.losses,
+                ties: row.ties
+            ),
+            for: coachID
+        )
+    }
